PORT=3000
PUBLIC_MCP_HOST=mcp.example.cn
ALLOWED_ORIGINS=https://codex.example.cn
SQLITE_PATH=./data.sqlite
CONTACT_GRAPH_ENABLED=false
CONTACT_GRAPH_SQLITE_PATH=./contact-graph.sqlite
CONTACT_GRAPH_BIN=/absolute/path/to/contact-graph
CONTACT_MAX_PENDING_FILES=10
CONTACT_MAX_FILE_BYTES=20971520
CONTACT_MAX_PDF_PAGES=50
CONTACT_MAX_IMAGE_PIXELS=25000000
CONTACT_MAX_TEMP_BYTES=1073741824
CONTACT_IMPORT_TIMEOUT_MS=900000
CONTACT_IMPORT_CONCURRENCY=1
CONTACT_EXTRACT_MAX_BATCHES=8
CONTACT_EXTRACT_MAX_MODEL_CALLS=16
# CONTACT_PYTHON_BIN=/absolute/path/to/python/.venv/bin/python
QCC_MCP_COMPANY_URL=https://agent.qcc.com/mcp/company/stream
QCC_MCP_RISK_URL=https://agent.qcc.com/mcp/risk/stream
QCC_MCP_IPR_URL=https://agent.qcc.com/mcp/ipr/stream
QCC_MCP_OPERATION_URL=https://agent.qcc.com/mcp/operation/stream
QCC_API_KEY=
DOUBAO_SEARCH_API_URL=https://open.feedcoopapi.com/search_api/web_search
DOUBAO_SEARCH_API_KEY=
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL=turbo
ARK_CREDENTIAL=
# 联系人向量检索使用独立配置，不复用聊天模型
# MODEL 填写支持文本嵌入的模型或端点 ID；CREDENTIAL 填写对应凭据
ARK_EMBEDDING_API_URL=
ARK_EMBEDDING_MODEL=
ARK_EMBEDDING_CREDENTIAL=
ARK_REQUEST_MAX_BYTES=12288
MAX_QCC_CALLS=8
MAX_SEARCH_CALLS=8
MAX_ARK_CALLS=16
MAX_TOTAL_UPSTREAM_CALLS=32
PROFILE_CACHE_TTL_DAYS=30
ASSESSMENT_CACHE_TTL_DAYS=30
MAX_CONCURRENT_ASSESSMENTS=1

# Optional admin API: SHA-256 of an independent admin key; blank disables it.
TOKEN_ADMIN_KEY_SHA256=

# Optional shared Zoho CRM connections. Keep source IDs stable: crm_a,crm_b.
# NAME also selects the organization for --crm qx|st (trimmed, case-insensitive).
# All MCP users still share CRM visibility. Organization IDs are read from Zoho
# during first binding, stored in tokens, and checked against saved bindings later.
ZOHO_CONNECTIONS=
ZOHO_CRM_A_NAME=QX
ZOHO_CRM_A_REGION=
ZOHO_CRM_A_CLIENT_ID=
ZOHO_CRM_A_CLIENT_SECRET=
ZOHO_CRM_A_REFRESH_TOKEN=
ZOHO_CRM_B_NAME=ST
ZOHO_CRM_B_REGION=
ZOHO_CRM_B_CLIENT_ID=
ZOHO_CRM_B_CLIENT_SECRET=
ZOHO_CRM_B_REFRESH_TOKEN=

# 持续企业研究（默认不注册研究工具；全局研究并发固定1）
COMPANY_RESEARCH_ENABLED=false
COMPANY_RESEARCH_TIMEOUT_MS=600000
COMPANY_RESEARCH_MAX_QUEUED=20
COMPANY_RESEARCH_MAX_PER_USER=3
# 实际业务请求预算，包括失败/重试；SDK握手不属于业务调用
COMPANY_RESEARCH_MAX_QCC_CALLS=4
COMPANY_RESEARCH_MAX_SEARCH_CALLS=16
COMPANY_RESEARCH_MAX_ARK_CALLS=8
COMPANY_RESEARCH_MAX_TOTAL_CALLS=28
